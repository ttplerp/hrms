 "css": "table {/* or margin: 0 auto 0 auto */\r\n    width: 100%;\r\n  }\r\n\r\n#main {\r\n   margin-left: 20px;\r\n   margin-right: 20px;\r\n}\r\n.customer-table {\r\n  width: 100%;\r\n  font-size: 8pt;\r\n  border-collapse: collapse; /* important */\r\n  table-layout: fixed;       /* important for column widths */\r\n}\r\n.customer-table td,\r\n.customer-table th {\r\n  border: 1px solid #ccc;\r\n  padding: 6px 8px;\r\n  vertical-align: middle;\r\n  word-wrap: break-word;\r\n  line-height: 1.4;        /* Add this - ensures consistent line height */\r\n}\r\n\r\n.customer-table .label {\r\n  vertical-align: middle;  /* Explicitly set this too */\r\n}\r\n\r\n.customer-table .value {\r\n  vertical-align: middle;  /* And this */\r\n}\r\n\r\n\r\n\r\n.label-fixed {\r\n    display: inline-block;\r\n    width: 140px;\r\n    font-weight: bold;\r\n}\r\n.label-fix {\r\n    display: inline-block;\r\n    width: 80px;\r\n    font-weight: bold;\r\n}\r\n\r\n\r\n@media all {\r\n   div .printedby {\r\n       position: fixed;\r\n       bottom: 0;\r\n       text-align: center;\r\n       font-size: 10pt;\r\n       width: 100% !important;\r\n   }\r\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "GST Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{%- if letter_head and not no_letterhead -%}\r\n<div class=\"letter-head\">{{ letter_head }}</div>\r\n{%- endif -%}\r\n\r\n<!-- ================== TITLE ================== -->\r\n<div class=\"print-heading\">\r\n    <div style=\"font-weight:bold; text-align:center; font-size:16px; margin-top:10px;\">\r\n        TAX INVOICE\r\n    </div>\r\n</div>\r\n\r\n<!-- ================== HEADER ================== -->\r\n<div class=\"row section-break\">\r\n    <!-- LEFT -->\r\n    <div class=\"col-xs-6\">\r\n        <div style=\"font-weight:bold;\">Bhutan Development Bank Limited</div>\r\n\r\n        <div class=\"data-field\">\r\n            <span class=\"label-fixed\">Office:</span>\r\n            <span class=\"value\">{{doc.branch}}</span>\r\n        </div>\r\n\r\n        <div class=\"data-field\">\r\n            <span class=\"label-fixed\">Taxpayer Number (TPN):</span>\r\n            <span class=\"value\">C10000000</span>\r\n        </div>\r\n\r\n        <div class=\"data-field\">\r\n            <span class=\"label-fixed\">Email:</span>\r\n            <span class=\"value\">info@bdb.bt</span>\r\n        </div>\r\n\r\n        <div class=\"data-field\">\r\n            <span class=\"label-fixed\">Phone:</span>\r\n            <span class=\"value\">1424</span>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- RIGHT -->\r\n    <div class=\"col-xs-6\" style=\"margin-top:15px;\">\r\n        <div class=\"data-field\">\r\n            <span class=\"label-fix\">Invoice No:</span>\r\n            <span class=\"value\">{{ doc.name }}</span>\r\n        </div>\r\n\r\n        <div class=\"data-field\">\r\n            <span class=\"label-fix\">Invoice Date:</span>\r\n            <span class=\"value\">{{ doc.posting_date }}</span>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<!-- ================== CUSTOMER DETAILS ================== -->\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-12\">\r\n    <table class=\"customer-table\">\r\n      <thead>\r\n        <tr>\r\n          <th colspan=\"2\">CUSTOMER DETAILS</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr>\r\n          <td style=\"width=15%; font-weight: bold;\" class=\"value\">Name:</td>\r\n          <td class=\"value\">{{ doc.customer_name }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td style=\"width=15%; font-weight: bold;\" class=\"value\">CID No:</td>\r\n          <td class=\"value\">{{ doc.cid }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td style=\"width=15%; font-weight: bold;\" class=\"value\">Taxpayer Number (TPN):</td>\r\n          <td class=\"value\">{{ doc.tpn }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td style=\"width=15%; font-weight: bold;\" class=\"value\">Contact No:</td>\r\n          <td class=\"value\">{{ doc.contact_no or \"-\" }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td style=\"width=15%; font-weight: bold;\" class=\"value\">Address:</td>\r\n          <td class=\"value\">{{ doc.address }}</td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</div>\r\n\r\n<!-- ================== SERVICE DETAILS ================== -->\r\n<div class=\"row section-break\">\r\n    <div class=\"col-xs-12\">\r\n        <table class=\"table table-bordered table-condensed\"\r\n               style=\"width:100%; font-size:8pt;\">\r\n            \r\n            <thead>\r\n                <tr>\r\n                  <th colspan=\"9\">SERVICES DETAILS</th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <thead>\r\n                <tr style=\"background:#f2f2f2;\">\r\n                    <th style=\"text-align:center;\">Sl No</th>\r\n                    <th style=\"text-align:center;\">Description</th>\r\n                    <th style=\"text-align:center;\">Qty</th>\r\n                    <th style=\"text-align:center;\">Discount</th>\r\n                    <th style=\"text-align:center;\">Exempt Value</th>\r\n                    <th style=\"text-align:center;\">Zero-rated Value</th>\r\n                    <th style=\"text-align:center;\">Fee & Charges Amount</th>\r\n                    <th style=\"text-align:center;\">GST (5%)</th>\r\n                    <th style=\"text-align:center;\">Total Amount</th>\r\n                </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n                {% set ns = namespace(total=0, total_gst=0, grand_total=0) %}\r\n\r\n                {% for row in doc.item %}\r\n                    {% set fee = row.fee_charges | default(0) %}\r\n                    {% set gst = row.gst | default(0) %}\r\n                    {% set amount = row.total_amount | default(0) %}\r\n\r\n                    {% set ns.total = ns.total + fee %}\r\n                    {% set ns.total_gst = ns.total_gst + gst %}\r\n                    {% set ns.grand_total = ns.grand_total + amount %}\r\n\r\n                    <tr>\r\n                        <td style=\"text-align:center;\">{{ loop.index }}</td>\r\n                        <td>{{ row.service_type }}</td>\r\n                        <td style=\"text-align:center;\">1</td>\r\n\r\n                        <td class=\"text-right\">\r\n                            {{ frappe.format_value(0, {\"fieldtype\":\"Currency\"}) }}\r\n                        </td>\r\n\r\n                        <td class=\"text-right\">\r\n                            {{ frappe.format_value(0, {\"fieldtype\":\"Currency\"}) }}\r\n                        </td>\r\n\r\n                        <td class=\"text-right\">\r\n                            {{ frappe.format_value(0, {\"fieldtype\":\"Currency\"}) }}\r\n                        </td>\r\n                        <td class=\"text-right\">\r\n                            {{ frappe.format_value(fee, {\"fieldtype\":\"Currency\"}) }}\r\n                        </td>\r\n\r\n                        <td class=\"text-right\">\r\n                            {{ frappe.format_value(gst, {\"fieldtype\":\"Currency\"}) }}\r\n                        </td>\r\n\r\n                        <td class=\"text-right\">\r\n                            {{ frappe.format_value(amount, {\"fieldtype\":\"Currency\"}) }}\r\n                        </td>\r\n                    </tr>\r\n                {% endfor %}\r\n\r\n                <!-- TOTAL ROW -->\r\n                <tr>\r\n                    <td colspan=\"7\"><b>Amount (in words):</b><br>\r\n                    {{ frappe.utils.money_in_words(ns.grand_total, doc.currency or \"BTN\") }}</td>\r\n                    <td colspan=\"1\"><b>Total</b></td>\r\n                    <td colspan=\"1\" class=\"text-right\">\r\n                        <b>{{ frappe.format_value(ns.grand_total, {\"fieldtype\":\"Currency\"}) }}</b>\r\n                    </td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n    </div>\r\n</div>\r\n\r\n\r\n\r\n<!-- ================== FOOTER ================== -->\r\n<div class=\"row section-break\" style=\"margin-top:6px; font-size:8pt;\">\r\n    <div class=\"col-xs-4\">\r\n        <b>Processing Officer:</b><br>\r\n        {{ doc.employee_name }}\r\n    </div>\r\n</div>\r\n",
