 "css": "table {\n    margin: 0 auto; /* or margin: 0 auto 0 auto */\n    width: 100%;\n  }\n\n#main {\n   margin-left: 20px;\n   margin-right: 20px;\n}\n@media all {\n   div .printedby {\n       position: fixed;\n       bottom: 0;\n       text-align: center;\n       font-size: 10pt;\n       width: 100% !important;\n   }\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "GST Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{%- if letter_head and not no_letterhead -%}\r\n<div class=\"letter-head\">{{ letter_head }}</div>\r\n{%- endif -%}\r\n\r\n<div class='print-heading'>\r\n\t<h3><div> GST Invoice </div></h3>\r\n</div>\r\n<div class=\"row section-break\">\r\n    <div class=\"col-xs-6 column-break\">\r\n\t\t<div class=\"row  data-field\" data-fieldname=\"posting_date\" data-fieldtype=\"Date\">\r\n\t\t\t<div class=\"col-xs-5\"> <label>Posting Date: </label> </div>\r\n\t\t\t<div class=\"col-xs-7 value\"> {{ doc.posting_date }} </div>\r\n\t\t</div>\r\n\t\t\r\n\t\t<div class=\"row  data-field\" data-fieldname=\"cid\" data-fieldtype=\"Data\">\r\n\t\t\t<div class=\"col-xs-5\"> <label>Customer CID: </label> </div>\r\n\t\t\t<div class=\"col-xs-7 value\"> {{ doc.cid }} </div>\r\n\t\t</div>\r\n\t\t\r\n\t\t<div class=\"row  data-field\" data-fieldname=\"company_tpn\" data-fieldtype=\"Data\">\r\n\t\t\t<div class=\"col-xs-5\"> <label>Company TPN: </label> </div>\r\n\t\t\t<div class=\"col-xs-7 value\"> BDBL123 </div>\r\n\t\t</div>\r\n\t</div>\r\n    <div class=\"col-xs-6 column-break\">\r\n\t\t<div class=\"row  data-field\" data-fieldname=\"customer\" data-fieldtype=\"Data\">\r\n\t\t\t<div class=\"col-xs-5\"> <label>Customer: </label> </div>\r\n\t\t\t<div class=\"col-xs-7 value\"> {{ doc.customer_name }} </div>\r\n\t\t</div>\r\n\t\t\r\n\t\t<div class=\"row  data-field\" data-fieldname=\"tpn\" data-fieldtype=\"Data\">\r\n\t\t\t<div class=\"col-xs-5\"> <label>Customer TPN: </label> </div>\r\n\t\t\t<div class=\"col-xs-7 value\"> {{ doc.tpn }} </div>\r\n\t\t</div>\r\n\t</div>\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n    <div class=\"col-xs-12 column-break\">\r\n        <div data-fieldname=\"item\" data-fieldtype=\"Table\">\r\n            <table class=\"table table-bordered table-condensed\" style=\"border: 2px; width: 100%; font-size:8pt !important;\">\r\n                <tbody>\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t\t<th style=\"text-align:center;\">Service Type</th>\r\n\t\t\t\t\t\t<th style=\"text-align:center;\">Fee & Charges Amount</th>\r\n\t\t\t\t\t\t<th style=\"text-align:center;\">GST(5%)</th>\r\n\t\t\t\t\t\t<th style=\"text-align:center;\">Total Amount</th>\r\n\t\t\t\t\t</tr>\r\n\t\t\t\t\t{% set ns = namespace(total=0, total_gst=0, total_amount=0) %}\r\n                    \r\n\t\t\t\t\t{%- for row in doc.item -%}\r\n\t\t\t\t\t    {% set ns.total = ns.total + (row.fee_charges | default(0)) %}\r\n                        {% set ns.total_gst = ns.total_gst + (row.gst | default(0)) %}\r\n                        {% set ns.total_amount = ns.total_amount + (row.total_amount | default(0)) %}\r\n    \t\t\t\t\t<tr>\r\n    \t\t\t\t\t\t<td>{{ row.service_type }}</td>\r\n    \t\t\t\t\t\t<td class=\"text-right\">{{ frappe.format_value(row.fee_charges, {\"fieldtype\":\"Currency\"}) }}</td>\r\n    \t\t\t\t\t\t<td class=\"text-right\">{{ frappe.format_value(row.gst, {\"fieldtype\":\"Currency\"}) }}</td>\r\n    \t\t\t\t\t\t<td class=\"text-right\">{{ frappe.format_value(row.total_amount, {\"fieldtype\":\"Currency\"}) }}</td>\r\n    \t\t\t\t\t</tr>\r\n\t\t\t\t\t{%- endfor -%}\r\n\t\t\t\t\t\r\n\t\t\t\t\t<tr>\r\n\t\t\t\t\t    <td>Total</td>\r\n\t\t\t\t\t    <td class=\"text-right\">{{ frappe.format_value(ns.total, {\"fieldtype\":\"Currency\"}) }}</td>\r\n                        <td class=\"text-right\">{{ frappe.format_value(ns.total_gst, {\"fieldtype\":\"Currency\"}) }}</td>\r\n                        <td class=\"text-right\">{{ frappe.format_value(ns.total_amount, {\"fieldtype\":\"Currency\"}) }}</td>\r\n\t\t\t\t\t</tr>\r\n            \t</tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n</div>\r\n<div class=\"row section-break\">\r\n    <div class=\"col-xs-4 column-break\">\r\n        <div class=\"row data-field\" data-fieldname=\"officer\">\r\n            <div class=\"col-xs-12\"> <label> Processing Officer: </label></div>\r\n            <div class=\"col-xs-12\"> {{ doc.employee_name }} </div>\r\n        </div>\r\n    </div>    \r\n</div>\r\n\r\n<!--<div class=\"printedby\"><i> Printed by {{ doc.employee_name }} </i></div>-->\r\n",
