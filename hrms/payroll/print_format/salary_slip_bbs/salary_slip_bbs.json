 "creation": "2025-06-04 12:35:52.952866",
 "css": "@page {\r\n        size: A4 portrait;\r\n        margin: 10mm;\r\n    }\r\n    body {\r\n        margin: 0;\r\n        padding: 0;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 9pt;\r\n    }\r\n    table {\r\n        border-collapse: collapse;\r\n    }\r\n    td, th {\r\n        padding: 2px;\r\n    }\r\n    .dotted-hr {\r\n        border-top: 1px dotted #000;\r\n        border-bottom: none;\r\n        border-left: none;\r\n        border-right: none;\r\n    }",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Salary Slip",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{%- if letter_head and not no_letterhead -%}\r\n    <div class=\"letter-head\">{{ letter_head }}</div>\r\n{%- endif -%}\r\n<div class=\"payslip-container\" style=\"font-family: 'Times New Roman', Times, serif; max-width: 800px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; font-size: 12pt;\">\r\n    <div class=\"header\" style=\"text-align: right; margin-bottom: 20px;\">\r\n        {%- set month_names = {\r\n            '1': 'January',\r\n            '01': 'January',\r\n            '2': 'February',\r\n            '02': 'February',\r\n            '3': 'March',\r\n            '03': 'March',\r\n            '4': 'April',\r\n            '04': 'April',\r\n            '5': 'May',\r\n            '05': 'May',\r\n            '6': 'June',\r\n            '06': 'June',\r\n            '7': 'July',\r\n            '07': 'July',\r\n            '8': 'August',\r\n            '08': 'August',\r\n            '9': 'September',\r\n            '09': 'September',\r\n            '10': 'October',\r\n            '11': 'November',\r\n            '12': 'December'\r\n        } -%}\r\n        <h2 style=\"margin-left: 390px; font-size: 12pt;\">\r\n            Pay Slip for the Month of {{ month_names.get(doc.month|string, doc.month) }}, {{ doc.fiscal_year }}\r\n        </h2>\r\n    </div>\r\n\r\n    <!-- Employee Summary -->\r\n    <div class=\"employee-summary\" style=\"margin-bottom: 30px;\">\r\n        <h3 class=\"section-title\" style=\"border-bottom: 1px solid #000; padding-bottom: 5px; font-size: 12pt; margin-bottom: 15px;\">EMPLOYEE SUMMARY</h3>\r\n        \r\n        <div class=\"employee-details\" style=\"display: flex; justify-content: space-between; margin-bottom: 15px;\">\r\n            <div class=\"employee-info\" style=\"min-width: 300px;\">\r\n                <div>Employee Name: {{ doc.employee_name }}</div>\r\n                <div>Designation: {{ doc.designation }}</div>\r\n                <div>Employee ID: {{ doc.employee }}</div>\r\n                <div>Date of Joining Service: {{ frappe.utils.formatdate(frappe.db.get_value(\"Employee\", doc.employee, \"date_of_joining\")) }}</div>\r\n                <div>Pay Period: {{ month_names.get(doc.month|string, doc.month) }}, {{ doc.fiscal_year }}</div>\r\n                <div>Pay Date: {{ frappe.utils.formatdate(doc.posting_date) }}</div>\r\n            </div>\r\n            <div class=\"net-pay-box\" style=\"border: 1px solid #000; padding: 8px; min-width: 200px; text-align: center;\">\r\n                <div class=\"net-pay-amount\" style=\"font-weight: bold; background-color: #05e3f7; padding: 5px; margin-bottom: 5px;\">\r\n                    Nu. {{ doc.net_pay }}<br>\r\n                    Employee Net Pay\r\n                </div>\r\n                <div>\r\n                    Paid Days: {{ doc.payment_days }}\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <hr class=\"dotted-hr\"></hr>\r\n        \r\n        <div class=\"account-details\" style=\"margin-bottom: 20px; font-family: 'Times New Roman', serif; font-size: 16px;\">\r\n    <div style=\"display: flex; justify-content: space-between; margin-bottom: 10px;\">\r\n        <div style=\"flex: 1; min-width: 0; padding-right: 15px;\">\r\n            <strong>PF A/C No:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"pf_number\") }}\r\n        </div>\r\n        <div style=\"flex: 1; min-width: 0; padding-left: 15px;\">\r\n            <strong>Bank Account No:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"bank_ac_no\") }}\r\n        </div>\r\n    </div>\r\n    <div style=\"display: flex; justify-content: space-between;\">\r\n        <div style=\"flex: 1; min-width: 0; padding-right: 15px;\">\r\n            <strong>TPN:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"tpn_number\") }}\r\n        </div>\r\n        <div style=\"flex: 1; min-width: 0; padding-left: 15px;\">\r\n            <strong>GIS Account No:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"gis_number\") }}\r\n        </div>\r\n    </div>\r\n</div>\r\n    </div>\r\n\r\n    <!-- Earnings and Deductions Table -->\r\n    <div style=\"border-radius: 8px; overflow: hidden; border: 1px solid #ddd;\">\r\n    <table class=\"earnings-deductions-table\" style=\"width: 100%; border-collapse: collapse; margin-bottom: 20px;\">\r\n        <thead>\r\n            <tr>\r\n                <th style=\"padding: 8px 10px; text-align: left; font-weight: bold; border-bottom: 1px solid #000;\">EARNINGS</th>\r\n                <th style=\"padding: 8px 10px; text-align: right; font-weight: bold; border-bottom: 1px solid #000;\">AMOUNT</th>\r\n                <th style=\"padding: 8px 10px; text-align: left; font-weight: bold; border-bottom: 1px solid #000;\">DEDUCTIONS</th>\r\n                <th style=\"padding: 8px 10px; text-align: right; font-weight: bold; border-bottom: 1px solid #000;\">AMOUNT</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for earning in doc.earnings %}\r\n            <tr style=\"border-bottom: 1px solid #ddd;\">\r\n                <td style=\"padding: 8px 10px;\">{{ earning.salary_component }}</td>\r\n                <td style=\"padding: 8px 10px; text-align: right;\">Nu. {{ earning.amount }}</td>\r\n                <td style=\"padding: 8px 10px;\">{% if loop.index0 < doc.deductions|length %}{{ doc.deductions[loop.index0].salary_component }}{% endif %}</td>\r\n                <td style=\"padding: 8px 10px; text-align: right;\">{% if loop.index0 < doc.deductions|length %}Nu. {{ doc.deductions[loop.index0].amount }}{% endif %}</td>\r\n            </tr>\r\n            {% endfor %}\r\n            <tr class=\"total-row\" style=\"border-top: 1px solid #000; font-weight: bold;\">\r\n                <td colspan=\"2\" style=\"padding: 8px 10px; text-align: right;\">Gross Pay Nu. {{ doc.gross_pay }}</td>\r\n                <td colspan=\"2\" style=\"padding: 8px 10px; text-align: right;\">Total Deductions Nu. {{ doc.total_deduction }}</td>\r\n            </tr>\r\n            <tr class=\"net-pay-row\" style=\"background-color: #f0f0f0; font-weight: bold;\">\r\n                <td colspan=\"4\" style=\"padding: 8px 10px; text-align: right;\">\r\n                    Net Pay: Nu. {{ doc.net_pay }}\r\n                </td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n</div>\r\n\r\n    <!-- Total Net Payable -->\r\n    <div class=\"total-net-payable\" style=\"border: 1px solid #000; border-radius: 8px; padding: 10px; margin-bottom: 20px;margin-top:10px;\">\r\n    <div class=\"total-net-payable-content\" style=\"display: flex; justify-content: space-between; align-items: center;\">\r\n        <div>\r\n            <h3 style=\"margin: 0 0 5px 0; font-size: 12pt;\">TOTAL NET PAYABLE</h3>\r\n            <p style=\"margin: 0;\">Gross Earnings -- Total Deductions</p>\r\n        </div>\r\n        <h3 style=\"margin: 0;\">Nu. {{ doc.net_pay }}</h3>\r\n    </div>\r\n</div>\r\n    \r\n    <p>Amount In Words: {{ doc.total_in_words }}</p>\r\n<hr></hr>\r\n    <!-- Footer -->\r\n    <div class=\"footer\" style=\"text-align: center; font-style: italic; margin-top: 30px;\">\r\n        ***This document has been automatically generated by ERP System; therefore, a signature is not required***\r\n    </div>\r\n</div>",
