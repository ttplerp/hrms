 "doctype": "Print Format",
 "font_size": 14,
 "html": "{%- if letter_head and not no_letterhead -%}\r\n    <div class=\"letter-head\">{{ letter_head }}</div>\r\n{%- endif -%}\r\n\r\n<div id=\"main\" style=\"margin-bottom: 5px;\">\r\n    <h3 align=\"center\" style=\"margin: 5px 0;\">SALARY SLIP</h3>\r\n    <h5 align=\"center\" style=\"margin: 5px 0;\"><u>{{doc.branch}}</u></h5> \r\n</div>\r\n\r\n<div style=\"margin-top: 5px; margin-bottom: 5px;\">\r\n    <table class=\"table1\" style=\"margin-top: 1px; font-size:9pt; width:100%; border-collapse: collapse;\">\r\n        <tr>\r\n            <td style=\"padding: 2px;\"><strong>Employee Name:</strong> {{doc.employee_name}}</td>\r\n            <td style=\"padding: 2px;\"><strong>Designation:</strong> {{ doc.designation }}</td>\r\n            <td style=\"padding: 2px;\"><strong>Employee Code:</strong> {{ doc.employee }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"padding: 2px;\"><strong>Citizen ID:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee,\"passport_number\") }}</td>\r\n            <td style=\"padding: 2px;\"><strong>Bank Details:</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"bank_ac_no\") }} ({{frappe.db.get_value(\"Employee\", doc.employee, \"bank_name\") }})</td>\r\n            <td style=\"padding: 2px;\"><strong>Tax Payer Number (TPN):</strong> {{ frappe.db.get_value(\"Employee\", doc.employee, \"tpn_number\") }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"padding: 2px;\"><strong>Date:</strong> {{frappe.utils.formatdate(doc.start_date)}} to {{frappe.utils.formatdate(doc.end_date)}}</td>\r\n            <td style=\"padding: 2px;\"><strong>Employee Grade:</strong> {{ doc.employee_grade }}</td>\r\n            <td style=\"padding: 2px;\"><strong>Date of Joining:</strong> {{ frappe.utils.formatdate(frappe.db.get_value(\"Employee\", doc.employee, \"date_of_joining\")) }}</td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n\r\n<table class=\"table table-bordered\" style=\"font-size:9pt; border: 2px solid #c7c8c9; width: 100%; border-collapse: collapse; margin-bottom: 5px;\">\r\n    <tbody>\r\n        <tr style=\"border:2px solid #c7c8c9\">\r\n            <td style=\"border:2px solid #c7c8c9; padding: 2px;\"> \r\n                <table style=\"border: 2px solid #c7c8c9; width: 100%; font-size:9pt !important; border-collapse: collapse;\">\r\n                    <tr style=\"border:2px solid #c7c8c9\">\r\n                        <th style=\"text-align:center;border:2px solid #c7c8c9; padding: 2px;\">Earnings</th>\r\n                        <th style=\"text-align:center;border:2px solid #c7c8c9; padding: 2px;\">Amount</th>\r\n                    </tr>\r\n                    {%- for row in doc.earnings -%}\r\n                    <tr style=\"border:2px solid #c7c8c9\">\r\n                        <td style=\"border:2px solid #c7c8c9; padding: 2px;\">{{ row.salary_component }}</td>\r\n                        <td class=\"text-right\" style=\"border:2px solid #c7c8c9; padding: 2px;\">{{ frappe.format_value(row.amount, {\"fieldtype\":\"Currency\"}) }}</td>\r\n                    </tr>\r\n                    {%- endfor -%}\r\n                </table>\r\n            </td>\r\n            <td style=\"border:2px solid #c7c8c9; padding: 2px;\"> \r\n                <table style=\"border: 2px solid #c7c8c9; width: 100%; font-size:9pt !important; border-collapse: collapse;\">\r\n                    <tr style=\"border:1px solid #c7c8c9\">\r\n                        <th style=\"text-align:center;border:2px solid #c7c8c9; padding: 2px;\">Deductions</th>\r\n                        <th style=\"text-align:center;border:2px solid #c7c8c9; padding: 2px;\">Amount</th>\r\n                    </tr>\r\n                    {%- for duc in doc.deductions -%}\r\n                    <tr style=\"border:2px solid #c7c8c9\">\r\n                        <td style=\"border:2px solid #c7c8c9; padding: 2px;\">{{ duc.salary_component }}</td>\r\n                        <td class=\"text-right\" style=\"border:2px solid #c7c8c9; padding: 2px;\">{{ frappe.format_value(duc.amount, {\"fieldtype\":\"Currency\"}) }}</td>\r\n                    </tr>\r\n                    {%- endfor -%}\r\n                </table>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=2 style=\"padding: 2px;\">\r\n                <table style=\"width: 100%; font-size:9pt; border-collapse: collapse;\">\r\n                    <tr>\r\n                        <td style=\"width: 25%; padding: 2px;\"><b>Total Earnings</b></td>\r\n                        <td style=\"width: 25%; padding: 2px;\" class=\"text-right\"><strong>{{frappe.format_value(doc.gross_pay, {\"fieldtype\":\"Currency\"})}}</strong></td>\r\n                        <td style=\"width: 25%; padding: 2px;\"><b>Total Deductions</b></td>\r\n                        <td style=\"width: 25%; padding: 2px;\" class=\"text-right\"><strong>{{frappe.format_value(doc.total_deduction, {\"fieldtype\":\"Currency\"}) }}</strong></td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td colspan=2 style=\"padding: 2px;\"></td>\r\n                        <td style=\"padding: 2px;\"><b>Net Amount</b></td>\r\n                        <td class=\"text-right\" style=\"padding: 2px;\">{{ frappe.format_value(doc.net_pay, {\"fieldtype\":\"Currency\"}) }}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td colspan=4 style=\"padding: 2px;\"><b>Amount in Words: </b>{{doc.total_in_words}}</td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td colspan=2 style=\"padding: 2px;\"></td>\r\n                        <td style=\"text-align: left; padding: 2px;\" colspan=2>Authorized Signatory</td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n\r\n<div style=\"margin-top: 5px;\">\r\n    <div class=\"printedby\" style=\"font-size: 8pt;\">This print is system generated and should be considered VALID only with appropriate seal and/or signature. <br>Printed by {{ frappe.user }} on {{ frappe.utils.nowdate() }} at {{ frappe.utils.nowtime() }}</div>\r\n</div>\r\n\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    {% if not no_letterhead and footer %}\r\n    <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n    </div>\r\n    {% endif %}\r\n    <p class=\"text-center small page-number visible-pdf\">\r\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n    </p>\r\n</div>",
