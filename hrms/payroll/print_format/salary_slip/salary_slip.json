 "css": "@page {\r\n        size: A4 portrait;\r\n        margin: 10mm;\r\n    }\r\n    body {\r\n        margin: 0;\r\n        padding: 0;\r\n        font-family: Arial, sans-serif;\r\n        font-size: 9pt;\r\n    }\r\n    table {\r\n        border-collapse: collapse;\r\n    }\r\n    td, th {\r\n        padding: 2px;\r\n    }",
 "custom_format": 1,
 "default_print_language": "en",
